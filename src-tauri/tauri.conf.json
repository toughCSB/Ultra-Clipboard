{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    },
    "windows": [
      {
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "decorations": false,
        "focusable": false,
        "height": 600,
        "label": "clipboard",
        "maximizable": false,
        "minHeight": 600,
        "minWidth": 360,
        "skipTaskbar": true,
        "title": "Ultra Clipboard",
        "transparent": true,
        "url": "index.html/#/",
        "visible": false,
        "width": 360
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npx pnpm@10.33.1 build",
    "beforeDevCommand": "npx pnpm@10.33.1 dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright 2026 toughCSB and ayangweb",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "description": "Ultra Clipboard history backup",
        "exportedType": {
          "conformsTo": ["public.data"],
          "identifier": "com.toughcsb.ultraclipboard.backup"
        },
        "ext": ["ecopastebak"],
        "mimeType": "application/vnd.ultraclipboard.backup",
        "name": "Ultra Clipboard Backup",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": ["assets/tray.ico"],
    "shortDescription": "Ultra Clipboard",
    "targets": ["nsis", "dmg", "app"]
  },
  "identifier": "com.toughcsb.ultraclipboard",
  "productName": "Ultra Clipboard",
  "version": "../package.json"
}
