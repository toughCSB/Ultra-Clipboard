* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# sqlx hashes migration files verbatim; a checked-out CRLF vs LF difference
# changes the embedded checksum even though the SQL is identical, which then
# looks like tampering to a database that already applied the migration.
src-tauri/migrations/*.sql text eol=lf

*.png binary
*.ico binary
*.icns binary
